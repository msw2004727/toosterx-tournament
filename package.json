{
  "name": "toosterx-tournament",
  "version": "0.20260904g",
  "private": true,
  "description": "ToosterX 賽事營運系統｜Tournament + Challenge",
  "type": "module",
  "scripts": {
    "serve": "npx --yes serve -l 5173 .",
    "emu": "node scripts/sync-engine.js && firebase emulators:start --only firestore,auth,functions --project demo-local",
    "seed:dry": "node scripts/seed.js --dry-run",
    "seed:emu": "node scripts/seed.js --emulator",
    "seed:demo": "node scripts/seed.js --project feda-cup-demo",
    "seed:reset": "node scripts/seed.js --project feda-cup-demo --reset",
    "bump": "node scripts/bump-version.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/mutation-guard.cjs && node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/",
    "test:unit:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/ --coverage",
    "test:mutation": "node scripts/mutation-check.cjs",
    "test:rules:unit": "node scripts/mutation-guard.cjs && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/firestore-rules/",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules-test \"npm run test:rules:unit\"",
    "test:e2e": "node scripts/mutation-guard.cjs && npx playwright test tests/e2e/",
    "test:e2e:staff": "npx playwright test --project=chromium-mobile --grep @staff",
    "test:e2e:offline": "npx playwright test --project=chromium-mobile --grep @offline",
    "deploy:rules:demo": "firebase deploy --only firestore:rules,firestore:indexes --project demo",
    "deploy:rules:prod": "firebase deploy --only firestore:rules,firestore:indexes --project prod",
    "deploy:fn:demo": "firebase deploy --only functions --project demo",
    "deploy:fn:prod": "firebase deploy --only functions --project prod",
    "deploy:storage:demo": "firebase deploy --only storage --project demo",
    "deploy:storage:prod": "firebase deploy --only storage --project prod",
    "sync:engine": "node scripts/sync-engine.js",
    "test:fn": "node scripts/sync-engine.js && firebase emulators:exec --only firestore --project demo-fn-test \"node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/functions/\"",
    "test:mutation:fn": "node scripts/sync-engine.js && firebase emulators:exec --only firestore --project demo-fn-test \"node scripts/mutation-fn.cjs\"",
    "test:mutation:rules": "firebase emulators:exec --only firestore --project demo-rules-test \"node scripts/mutation-rules.cjs\"",
    "mutation:guard": "node scripts/mutation-guard.cjs",
    "test:mutation:e2e": "node scripts/mutation-e2e.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.56.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^14.27.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {},
    "collectCoverageFrom": [
      "js/engine/**/*.js",
      "js/lib/**/*.js"
    ],
    "coverageDirectory": "coverage"
  }
}
