{
  "name": "toosterx-tournament",
  "version": "0.20260828",
  "private": true,
  "description": "ToosterX 賽事營運系統｜Tournament + Challenge",
  "type": "module",
  "scripts": {
    "serve": "npx --yes serve -l 5173 .",
    "emu": "firebase emulators:start --only firestore,auth --project demo-local",
    "seed:demo": "node scripts/seed.js --project feda-cup-demo",
    "seed:reset": "node scripts/seed.js --project feda-cup-demo --reset",
    "bump": "node scripts/bump-version.js",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/",
    "test:unit:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/ --coverage",
    "test:rules:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/firestore-rules/",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules-test \"npm run test:rules:unit\"",
    "test:e2e": "npx playwright test tests/e2e/",
    "test:e2e:smoke": "npx playwright test tests/e2e/ --project=chromium-mobile --grep @smoke",
    "deploy:rules:demo": "firebase deploy --only firestore:rules,firestore:indexes,storage --project demo",
    "deploy:rules:prod": "firebase deploy --only firestore:rules,firestore:indexes,storage --project prod",
    "deploy:fn:demo": "firebase deploy --only functions --project demo",
    "deploy:fn:prod": "firebase deploy --only functions --project prod",
    "seed:dry": "node scripts/seed.js --dry-run",
    "seed:emu": "node scripts/seed.js --emulator"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.56.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^14.27.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {},
    "collectCoverageFrom": [
      "js/engine/**/*.js",
      "js/lib/**/*.js"
    ],
    "coverageDirectory": "coverage"
  }
}