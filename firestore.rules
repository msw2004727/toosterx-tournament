rules_version = '2';

// ══════════════════════════════════════════════════════════════════
//  toosterx-tournament｜Firestore 安全規則
//  規格：docs/07-權限安全與CloudFunctions.md
//
//  設計前提：比分「寫入」放在客戶端（為了拿到 SDK 的離線佇列），
//            所以 rules 就是唯一防線，必須寫得很緊。
//
//  ⚠️ 修改後務必跑 `npm run test:rules`（R01–R23 全綠才可部署）
// ══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{db}/documents {

    // ── 基礎 ─────────────────────────────────────────────────
    function isAuth()    { return request.auth != null; }
    function uid()       { return request.auth.uid; }
    function staffPath() { return /databases/$(db)/documents/staff/$(uid()); }

    // ⚠️ 效能鐵則：Firestore rules 每個請求最多評估 1000 個運算式。
    //    角色判斷一律經過 myRoles()，**不要**再寫 isA() 呼叫 isB() 的巢狀鏈
    //    （例如 isScorer → isAdmin → hasRole → isStaff），
    //    那會把 staff 文件重複展開數十次，很容易撞到上限，
    //    讓「合法」的寫入也被判 PERMISSION_DENIED。
    function myRoles() {
      return isAuth() && exists(staffPath()) && get(staffPath()).data.active == true
        ? get(staffPath()).data.roles
        : [];
    }
    function isStaff()      { return myRoles().size() > 0; }

    // ── 賽務角色的繼承鏈（主辦 2026-09-03 指定：向上包含）─────────
    //
    //   挑戰攤位 < 檢錄員 < 裁判 < 記錄員 < 管理員 < 總管
    //
    // ⚠️ 每一個判斷都從 myRoles() **攤平列出鏈上所有更高的角色**，
    //    不要寫成 isCheckin() { return isReferee() || ... }——
    //    那是 R-RULES-001 禁止的巢狀鏈，會把 staff 文件重複展開數十次，
    //    很容易撞到每請求 1000 運算式的上限，讓合法寫入被誤擋。
    //    程式碼看起來重複是刻意的：這裡的重複換來的是可預測的成本。
    //
    // ⚠️ **鏈上沒有 venue_owner。** 它是 FC 的角色（level 3），
    //    數值正好夾在記錄員(2.4)與管理員(4)之間；如果用 level 比大小，
    //    一個從 FC 同步過來的「場主」會自動拿到記錄員的全部權限。
    //    這裡明列，所以不會。與 js/config.js 的 STAFF_CHAIN 是同一份清單。
    function isSuperAdmin() { return myRoles().hasAny(['super_admin']); }
    function isAdmin()      { return myRoles().hasAny(['admin', 'super_admin']); }
    function isScorer()     { return myRoles().hasAny(['scorer', 'admin', 'super_admin']); }
    function isReferee()    { return myRoles().hasAny(['referee', 'scorer', 'admin', 'super_admin']); }
    function isCheckin()    { return myRoles().hasAny(['checkin', 'referee', 'scorer',
                                                        'admin', 'super_admin']); }
    function isBooth()      { return myRoles().hasAny(['booth', 'checkin', 'referee', 'scorer',
                                                        'admin', 'super_admin']); }

    // ── 指派範圍 ─────────────────────────────────────────────
    // 只有非 admin 才會走到 myAssignment()，此時 staff 文件必定存在
    function myAssignment() { return get(staffPath()).data.assignment; }
    // 挑戰卡的主人：users/{uid}.gamePassId 指到這一張（users 是私密的，公開的 players 上不放 uid）
    function ownsPass(pid) {
      return get(/databases/$(db)/documents/users/$(uid())).data.gamePassId == pid;
    }
    function assignedVenue(venueId) {
      return myRoles().hasAny(['admin', 'super_admin'])
        || myAssignment().venueIds.size() == 0
        || venueId in myAssignment().venueIds;
    }
    function assignedChallenge(cid) {
      return myRoles().hasAny(['admin', 'super_admin'])
        || cid in myAssignment().challengeIds;
    }

    // ── 報名（M4，docs/10 §2.3／§5.2）───────────────────────
    // ⚠️ 這一組會做 get()，但只出現在報名相關路徑，不在比分寫入的熱路徑上，
    //    所以不會壓縮到 1000 運算式的預算（R-RULES-001）。
    //
    // 開放條件是 AND：主辦手動開關 **且** 現在在起訖區間內（docs/10 §2.3）。
    // 少任何一邊，主辦就沒辦法提前關閉或延長。
    // 設定文件不存在時一律視為**未開放**——fail-closed，不要「沒設定就當開著」。
    function regOpen() {
      let p = /databases/$(db)/documents/config/registration;
      return exists(p)
        && get(p).data.get('open', false) == true
        && (get(p).data.get('opensAt', null) == null || request.time >= get(p).data.opensAt)
        && (get(p).data.get('closesAt', null) == null || request.time <= get(p).data.closesAt);
    }

    // staff 文件可以被指派的角色。**白名單裡沒有 super_admin**：
    // 大總管不能由介面產生第二個（docs/10 §5.1）。第一位由種子／Console 建立，
    // 走的是 Admin SDK，不經過 rules。
    function staffRolesAssignable(d) {
      return d.roles is list && d.roles.size() > 0
          && d.roles.hasOnly(['scorer', 'referee', 'checkin', 'booth', 'admin']);
    }

    // ── Demo 自助身分（見下方 match /staff/{u} 的說明）─────────
    // 只在 config/env.allowSelfServeStaff == true 的專案生效。
    // 這個 get() 只出現在 staff 文件的 create/update 路徑，
    // 不在比分寫入的熱路徑上，所以不會影響 1000 運算式上限（R-RULES-001）。
    function selfServeAllowed() {
      return exists(/databases/$(db)/documents/config/env)
        && get(/databases/$(db)/documents/config/env).data.get('allowSelfServeStaff', false) == true;
    }
    function validSelfServe(d) {
      return d.get('selfServe', false) == true
        && d.get('uid', '') == uid()
        && d.get('active', false) == true
        && d.roles is list
        && d.roles.size() > 0
        // ⚠️ **不含 super_admin**，而且永遠不會加進來：
        //    大總管是唯一能指派身分的人（R-RULES-003），自助拿得到就等於
        //    「任何人登入一次就能發身分給任何人」。
        //    admin 在 demo 上是必要的——覆核完賽、退回報名這些流程要測得到，
        //    而這一整段本來就只在 config/env.allowSelfServeStaff 為真的專案生效，
        //    正式專案沒有那份文件。
        && d.roles.hasOnly(['scorer', 'referee', 'checkin', 'booth', 'admin']);
    }

    // ── 欄位控制 ─────────────────────────────────────────────
    function onlyChanged(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    function unchanged(f) {
      return request.resource.data[f] == resource.data[f];
    }
    function validScore(v) {
      return v is int && v >= 0 && v <= 99;
    }

    // scoreSubmittedAt 只能保持原樣，或被寫成「這一次請求的伺服器時間」
    // （也就是客戶端用 serverTimestamp() 寫的值）。
    // 沒有這一條的話，賽務可以先塞一個很遠的未來時間進去，
    // 讓下面 (D) 的三分鐘視窗變成無限期。
    function serverStampedSubmit() {
      return request.resource.data.get('scoreSubmittedAt', null)
               == resource.data.get('scoreSubmittedAt', null)
          || request.resource.data.get('scoreSubmittedAt', null) == request.time
          || request.resource.data.get('scoreSubmittedAt', null) == null;
    }

    // 完賽就必須同時上鎖。
    // 沒有這一條的話，賽務只要在送出完賽時「不寫 lock.locked = true」，
    // 場次就會停在「已完賽但未鎖定」——分支 (B) 的 lock.locked == false 永遠成立，
    // 於是已完賽的比分可以被無限期改寫，而且完全不受三分鐘視窗約束。
    // 「完賽即鎖定」是自撤回設計的前提，前提本身必須由規則守住，
    // 不能只靠客戶端的 buildFinishPatch 有沒有好好填。
    function finishMustLock() {
      return request.resource.data.status != 'finished'
          || request.resource.data.lock.locked == true;
    }

    // 非 Admin 分支專用的狀態機。
    // postponed / cancelled / walkover 一律不在清單中，
    // 因此只有 Admin 分支（不經此函式）才設得了這三種狀態。
    function validStatusTransition(from, to) {
      return (from == 'scheduled' && to in ['checkin', 'ready', 'live'])
          || (from == 'checkin'   && to in ['ready', 'scheduled'])
          || (from == 'ready'     && to in ['live', 'checkin'])
          || (from == 'live'      && to in ['halftime', 'finished'])
          || (from == 'halftime'  && to in ['live', 'finished'])
          || from == to;
    }

    // ══════════════════════════════════════════════════════════
    match /events/{eventId} {
      allow read:  if true;
      allow write: if isAdmin();

      function validChallengeScore(cid, v) {
        let c = get(/databases/$(db)/documents/events/$(eventId)/challenges/$(cid)).data;
        return v is number && v >= c.minValue && v <= c.maxValue;
      }

      // ── 組別／階段／小組 ──
      match /divisions/{divisionId} {
        allow read:  if true;
        allow write: if isAdmin();
        match /{sub=**} {
          allow read:  if true;
          allow write: if isAdmin();
        }
      }

      // ── 球隊 ──
      // 隊長：決定申請、移除隊員、改備註、調背號。
      // 備註凍結後也能改（不影響參賽資格，docs/10 §4），
      // 但「誰在這支隊」的決定只能在凍結前做。
      function captainMemberPatchOk(tid) {
        return onlyChanged(['status', 'decidedAt', 'decidedBy', 'note', 'jerseyNo', 'updatedAt'])
            && ( onlyChanged(['note', 'updatedAt'])
                 || ( !rosterFrozen(tid)
                      && captainMemberTransition(resource.data.status,
                                                 request.resource.data.status)
                      // 同意一位球員的申請＝多一位球員，第 16 位不給同意
                      && ( request.resource.data.status != 'approved'
                           || resource.data.status == 'approved'
                           || playerRoomLeft(tid, resource.data.get('kind', 'player')) ) ) );
      }
      function captainMemberTransition(from, to) {
        return (from == 'pending'  && to in ['pending', 'approved', 'rejected'])
            || (from == 'approved' && to in ['approved', 'removed'])
            // 被系統退件的那幾筆（每人限報乙隊、重複申請）隊長要能從名單上收掉，
            // 不然每退一次就多一列永遠留在畫面上（2026-09-06 驗收：同一個孩子重試了四次）
            || (from == 'rejected' && to in ['rejected', 'removed'])
            || from == to;
      }

      // 隊長（球隊負責人）直接新增名單。學童三組走這條，不走邀請碼：
      // 小球員沒有 LINE 帳號，家長也不見得會操作（主辦 2026-09-03 指定）。
      //
      // 這條路**不限組別**——隊長本來就能核准任何一筆申請，直接新增
      // 不會多給他任何權限，只是少繞一圈。哪一組要用邀請碼、哪一組
      // 由教練自己填，是介面的事，不是權限邊界。
      //
      // `source == 'coach'` 不只是標記：下面的 coachMemberEditOk() 靠它
      // 判斷「這筆是不是隊長自己填的」。家長送的那幾筆隊長只能同意或
      // 婉拒，不能改人家填的內容。
      function coachAddedMemberOk() {
        return request.resource.data.get('source', '') == 'coach'
            && request.resource.data.get('addedBy', '') == uid()
            && request.resource.data.status == 'approved'
            && request.resource.data.get('guardianUid', null) == null;
      }

      // 球員最多 15 人（競賽規章第十二條）。
      //
      // rules 沒辦法 count 子集合，所以看的是 Function 維護在球隊文件上的
      // `playerCount`（只數已核准的球員，不含隊職員——跟審核頁同一份 isPlayer）。
      // 這個數字是**事後**算的：兩位教練同一秒各加一人，兩筆都會過；
      // 權威在 Function 的 enforceRosterCap，超過的那幾筆會被退件。
      // 這裡擋的是「第 16 位一按下去就知道不行」，不是最後一道。
      //
      // ⚠️ 15 這個數字跟 js/engine/formats.js 的 REGISTRATION_LIMITS.maxPlayers
      //    要一致，tests/unit/regulation-parity.test.js 盯著。
      function playerRoomLeft(tid, kind) {
        return kind != 'player'
            || get(teamPath(tid)).data.get('playerCount', 0) < 15;
      }

      // 隊長改自己填的那幾筆。改別人（家長）填的一律擋掉。
      function coachMemberEditOk(tid) {
        return resource.data.get('source', '') == 'coach'
            && !rosterFrozen(tid)
            && unchanged('status')
            && onlyChanged(['name', 'birthDate', 'idLast4', 'jerseyNo',
                            'position', 'kind', 'role', 'note',
                            'glasses', 'glassesWaiver', 'updatedAt']);
      }

      // 家長／本人：申請還沒被決定之前可以修正自己填的資料，
      // 但**不能自己把 status 改成 approved**——那就等於不用隊長同意了。
      function guardianMemberPatchOk() {
        return request.resource.data.status == 'pending'
            && unchanged('guardianUid')
            && onlyChanged(['name', 'birthDate', 'idLast4', 'jerseyNo', 'position',
                            'kind', 'consent', 'glasses', 'glassesWaiver', 'updatedAt']);
      }

      // ── 球隊與名單（M4，docs/10 §5.2）────────────────────────
      // 隊長不是全站角色，是球隊文件上的一個欄位（docs/10 §1.2）：
      // 同一個人可能是 A 隊隊長、同時是 B 隊球員，做成角色就分不清了。
      function teamPath(tid) { return /databases/$(db)/documents/events/$(eventId)/teams/$(tid); }
      function isCaptainOf(tid) {
        return isAuth() && exists(teamPath(tid))
            && get(teamPath(tid)).data.get('captainUid', '') == uid();
      }

      // 名單凍結：隊長按下「送出報名」的當下就凍結（docs/10 §3.1）。
      // 從送出到主辦審核可能隔好幾天，這期間名單還能改的話，
      // 主辦審的跟通過的會是兩份不同的東西。
      // rosterLocked 是 Admin 審核通過後的第二道鎖。
      function rosterFrozen(tid) {
        let t = get(teamPath(tid)).data;
        return !(t.get('status', 'draft') in ['draft', 'rejected'])
            || t.get('rosterLocked', false) == true;
      }

      // 隊長只動得了這份白名單上的欄位。
      // rosterLocked / memberCount / seed / finalRank / reviewedAt / reviewedBy /
      // rejectReason / divisionId 都**不在**上面——少了這道，隊長送出報名之後
      // 可以自己把 rosterLocked 關掉，凍結就形同虛設。
      //
      // ⚠️ 白名單就是唯一的那道閘，不要再加一條「rosterLocked 必須不變」。
      //    第一版兩條都寫了，於是拆掉任何一條測試都照樣全綠——
      //    兩道一模一樣的守衛互相遮蔽，等於兩道都沒有被測到（變異 RU#6）。
      function captainTeamPatchOk() {
        return onlyChanged(['name', 'shortName', 'abbr', 'colorPrimary', 'contact',
                            'announcement', 'status', 'captainUid', 'captainName',
                            'submittedAt', 'cancelRequest', 'updatedAt', 'updatedBy'])
            // 凍結之後只准撤回（動 status）或申請取消（規章第二十七條，寫 cancelRequest），
            // 隊伍資料本身不能再編輯。取消要由主辦處理（status 變 withdrawn 只有 Admin 設得了）
            && ( resource.data.get('status', 'draft') in ['draft', 'rejected']
                 || onlyChanged(['status', 'submittedAt', 'updatedAt', 'updatedBy'])
                 || onlyChanged(['cancelRequest', 'updatedAt', 'updatedBy']) );
      }

      // 隊長走得到的狀態轉換只有「送出」與「撤回」，以及被退回之後重新編輯。
      // approved / rejected / withdrawn 一律只有 Admin 設得了（docs/10 §3）。
      //
      // ⚠️ 被退回的球隊要能**直接**再送出（rejected → submitted）。管理頁在退回
      //    狀態畫的就是「送出報名」那顆鈕；第一版這裡只放行 rejected → draft，
      //    於是隊長改完按送出，本機快照先變成「待主辦審核」、下一秒被規則打回來，
      //    畫面只說「可能是報名已經截止」——被退回的球隊永遠送不出去
      //    （2026-09-06 在 demo 實測抓到，R98c／RU#46）。
      // 草稿可以由隊長自己取消（withdrawn）：還沒送出、沒有報名費，不必勞煩主辦。
      // 送出之後就只能「申請取消」，取消與退費由主辦處理（2026-09-06 驗收：草稿沒有任何取消的路）。
      function captainTeamTransition(from, to) {
        return (from == 'draft'     && to in ['draft', 'submitted', 'withdrawn'])
            || (from == 'submitted' && to in ['submitted', 'draft'])
            || (from == 'rejected'  && to in ['rejected', 'draft', 'submitted'])
            // 狀態不動的更新（例如已核准之後申請取消）：欄位仍由 captainTeamPatchOk 的白名單管
            || from == to;
      }

      match /teams/{teamId} {
        allow read: if true;

        // 建立：登入 + 報名開放中 + 自己是隊長。
        // ⚠️ docs/10 §2.3 的「每個帳號最多 3 隊」**不在這裡**：
        //    rules 沒辦法 count 文件。那道上限由 Function 維護
        //    users/{uid}.teamCount 並在超額時退件，屬於防洗版而非權限邊界。
        allow create: if isAuth()
                      && request.resource.data.captainUid == uid()
                      && request.resource.data.status == 'draft'
                      && request.resource.data.get('rosterLocked', false) == false
                      && request.resource.data.get('memberCount', 0) == 0
                      && request.resource.data.get('playerCount', 0) == 0
                      && regOpen();

        allow update: if isAdmin()
                      || ( isCaptainOf(teamId)
                           && captainTeamPatchOk()
                           && captainTeamTransition(resource.data.get('status', 'draft'),
                                                    request.resource.data.status) );
        allow delete: if isAdmin();

        // 聯絡資訊等敏感欄位放子集合，避免公開讀取
        match /private/{docId} {
          allow read, write: if isScorer();
        }

        // 完整名單（生日、身分證後四碼）：賽務以上、該隊隊長、以及自己報的那一筆
        match /members/{memberId} {
          // ⚠️ 檢錄員讀得到這裡，因為**生日與身分證後四碼只存在這一份文件上**。
          //    公開的 roster 投影一個都沒有（ROSTER_FIELDS 白名單），
          //    而檢錄當天要拿證件跟這兩格核對。
          //    isCheckin() 已含 scorer／referee／admin，不要再串 isScorer()
          //    ——那是 R-RULES-001 禁止的巢狀鏈。
          allow read: if isCheckin()
                      || isCaptainOf(teamId)
                      || (isAuth() && resource.data.get('guardianUid', '') == uid());

          // 加入申請不另開集合，就是名單上 status == 'pending' 的那幾筆（docs/10 §2.2）。
          // 知道 inviteCode 只能「申請」，不等於「加入」——隊長同意才是閘門（§3.3）。
          //
          // ⚠️ §3.3 的「同一帳號對同一隊只能有一筆申請」**沒有寫在這裡**：
          //    rules 查不到「有沒有另一筆 guardianUid 相同且 pending 的文件」。
          //    那一條由 Function 與介面把關；rules 守的是真正的權限邊界。
          allow create: if isAuth()
                        && regOpen()
                        && !rosterFrozen(teamId)
                        && (
                             // (A) 家長／本人用邀請碼申請 → 一定是 pending
                             ( request.resource.data.get('guardianUid', '') == uid()
                               && request.resource.data.status == 'pending' )
                             // (B) 隊長直接新增（學童組的流程）→ 直接進名單。
                             //     直接進名單＝直接算進 15 人，所以這裡就要看得到還有沒有位子
                             || ( isCaptainOf(teamId) && coachAddedMemberOk()
                                  && playerRoomLeft(teamId, request.resource.data.get('kind', 'player')) )
                           );

          allow update: if isAdmin()
                        || ( isCaptainOf(teamId) && captainMemberPatchOk(teamId) )
                        || ( isCaptainOf(teamId) && coachMemberEditOk(teamId) )
                        || ( isAuth()
                             && resource.data.get('guardianUid', '') == uid()
                             && resource.data.status == 'pending'
                             && guardianMemberPatchOk() );

          // 移除是把 status 改成 'removed'，不刪文件（docs/10 §4）
          allow delete: if false;
        }

        // 公開投影：任何人可讀，只有 Admin SDK（Function）可寫
        match /roster/{memberId} {
          allow read:  if true;
          allow write: if false;
        }
      }

      // ── 場次 ──
      match /matches/{matchId} {
        allow read: if true;
        allow create, delete: if isAdmin();

        allow update: if
          // (A) Admin 全權
          isAdmin()

          // (B) 賽務：限指派場地、限未鎖定、限白名單欄位
          || ( isScorer()
               && assignedVenue(resource.data.venueId)
               && resource.data.lock.locked == false
               && onlyChanged([
                    'score', 'htScore', 'penaltyScore', 'status', 'period', 'clock',
                    'result', 'checkin', 'lock', 'scoreSubmittedAt', 'scoreSubmittedBy',
                    'scoreMismatch', 'updatedAt', 'updatedBy'
                  ])
               && request.resource.data.updatedBy == uid()
               && validStatusTransition(resource.data.status, request.resource.data.status)
               && validScore(request.resource.data.score.home)
               && validScore(request.resource.data.score.away)
               && unchanged('home') && unchanged('away')
               && unchanged('divisionId') && unchanged('stageId')
               && serverStampedSubmit()
               && finishMustLock() )

          // (C) 覆核：已鎖定的 finished 改成 confirmed，只准動 status。
          //     這一支現在只有 Admin 走得到（isAdmin() 在 (A) 已經全開），
          //     保留條文是為了讓「覆核」這個動作在規則裡看得見，
          //     日後若要再開給某個受限角色，改這一行就好。
          || ( isAdmin()
               && resource.data.status == 'finished'
               && request.resource.data.status == 'confirmed'
               && onlyChanged(['status', 'updatedAt', 'updatedBy'])
               && request.resource.data.updatedBy == uid() )

          // (D) 三分鐘自撤回：送出完賽的人本人，可以在三分鐘內把場次退回進行中。
          //     （docs/10 §5.3。這是 (B) 走不到的路徑——完賽當下已經 lock.locked = true。）
          //
          //     時間基準完全在伺服器手上：
          //       resource.data.scoreSubmittedAt  ← 上一次寫入時的 request.time（見 serverStampedSubmit）
          //       request.time                    ← 這一次的伺服器時間
          //     所以把手機時間往回調沒有用，離線放著等一小時再送也沒有用。
          //     ⚠️ 三分鐘這個數字與 js/modules/staff/live-actions.js 的
          //        UNDO_WINDOW_SEC 必須一致，改一邊要改兩邊（R09b 測試會抓）。
          || ( isScorer()
               && assignedVenue(resource.data.venueId)
               && resource.data.status == 'finished'
               && resource.data.get('scoreSubmittedBy', '') == uid()
               && resource.data.get('scoreSubmittedAt', null) != null
               && request.time < resource.data.scoreSubmittedAt + duration.value(3, 'm')
               && request.resource.data.status == 'live'
               && request.resource.data.lock.locked == false
               && request.resource.data.get('scoreSubmittedAt', null) == null
               && onlyChanged(['status', 'period', 'lock', 'result',
                               'scoreSubmittedAt', 'scoreSubmittedBy',
                               'updatedAt', 'updatedBy'])
               && request.resource.data.updatedBy == uid() )

          // (E) 檢錄：完成一隊的檢錄時把旗標寫回場次（docs/04 §4.6、docs/01b §1.7 的 checkin）。
          //     isCheckin() 已含裁判／記錄員／管理員。只動 checkin 這一包與
          //     「未開始／檢錄中／待開賽」之間的狀態——比分、時鐘、完賽在這條路上一律寫不進去
          //     （R82c／R82d 守著），場地限制與 (B) 相同。
          //     第三輪驗收 C-5 之前「完成檢錄」什麼都沒寫，因為檢錄員根本沒有一條寫得到場次的路。
          || ( isCheckin()
               && assignedVenue(resource.data.venueId)
               && resource.data.lock.locked == false
               && onlyChanged(['checkin', 'status', 'updatedAt', 'updatedBy'])
               && request.resource.data.updatedBy == uid()
               && ( request.resource.data.status == resource.data.status
                    || request.resource.data.status in ['checkin', 'ready'] )
               && validStatusTransition(resource.data.status, request.resource.data.status) );

        // ── 比賽事件：永不刪除，只作廢 ──
        match /timeline/{timelineId} {
          allow read:   if true;
          allow create: if (isScorer() || isAdmin())
                        && request.resource.data.createdBy == uid()
                        && request.resource.data.matchId == matchId;
          allow update: if isAdmin()
                        || (isScorer()
                            && onlyChanged(['voided', 'voidedBy', 'voidedAt', 'voidReason']));
          allow delete: if false;
        }
      }

      // ── 積分榜：Function 走 Admin SDK 繞過 rules ──
      match /standings/{standingId} {
        allow read:  if true;
        allow write: if isAdmin();
      }

      // 出場名單是裁判的職能（主辦 2026-09-03 的階層：裁判 < 記錄員）。
      // isReferee() 已含 scorer／admin／super_admin，不必再串 isAdmin()。
      match /matchSheets/{sheetId} {
        allow read:  if true;
        allow write: if isReferee();
      }

      // ── 檢錄：doc id = matchId__memberId，天然防重複 ──
      match /checkins/{checkinId} {
        allow read:   if isCheckin();
        allow create: if isCheckin()
                      && request.resource.data.scannedBy == uid()
                      && checkinId == request.resource.data.matchId + '__'
                                      + request.resource.data.memberId;
        // 勾錯了要改得回來（學童組是用眼睛核對證件，不是掃碼）。
        // 只放行結果與備註，matchId／memberId 換掉就等於偽造另一筆。
        allow update: if isAdmin()
                      || ( isCheckin()
                           && onlyChanged(['result', 'failReason', 'note',
                                           'method', 'scannedBy', 'scannedAt', 'syncedAt'])
                           && request.resource.data.scannedBy == uid() );
        allow delete: if false;
      }

      match /venues/{venueId} {
        allow read:  if true;
        allow write: if isAdmin();
      }

      // ── 彙總看板：Function 產出 ──
      match /boards/{boardId} {
        allow read:  if true;
        allow write: if false;
      }

      // ── Challenge ──
      match /challenges/{challengeId} {
        allow read:  if true;
        allow write: if isAdmin();
      }

      match /players/{playerId} {
        allow read: if true;
        // 挑戰卡由 Function 綁 LINE 帳號配發（Admin SDK 不經 rules）；玩家不能再自己建
        // （主辦 2026-09-06 決定）。這裡只留攤位代建那一條，欄位與初始值仍受限。
        allow create: if isBooth()
                      && request.resource.data.keys().hasOnly([
                          'playerId', 'eventId', 'nickname', 'avatarSeed', 'ageBand',
                          'qrCode', 'createdAt', 'createdVia', 'completedChallengeIds',
                          'luckyDrawEntries', 'linkedTeamId', 'lastActiveAt', 'contact',
                          'contactKeyHash'
                        ])
                      && request.resource.data.nickname is string
                      && request.resource.data.nickname.size() >= 1
                      && request.resource.data.nickname.size() <= 12
                      && request.resource.data.completedChallengeIds.size() == 0
                      && request.resource.data.luckyDrawEntries == 0;
        // 進度與抽獎張數只有 Function／Admin 可改。
        //
        // ⚠️ `contact` **刻意不在這裡**。這一條沒有任何身分條件——代號空間
        //    只有 FEDA-0000–9999 一萬組，掃得完，等於「任何人都改得動任何人的
        //    這幾格」。暱稱被亂改是玩笑（重新輸入就好），聯絡方式被覆寫是
        //    兌獎爭議（中獎人聯絡不到，而且 players 不寫稽核，事後查不出是誰）。
        //    兩者的可回復性差太多，不該當成同一件事。
        //
        //    docs/06 §7.2 的「填寫聯絡方式」做出來時，要走 Function 寫
        //    （或另外設計一組只有本人知道的憑證）。在那之前收在這裡最便宜：
        //    今天沒有任何一行程式在更新 contact，拿掉不會壞任何東西。
        allow update: if isAdmin()
                      || ( isAuth() && ownsPass(playerId)
                           && onlyChanged(['nickname', 'lastActiveAt']) );
        allow delete: if isAdmin();
      }

      match /attempts/{attemptId} {
        allow read:   if true;
        allow create: if isBooth()
                      && assignedChallenge(request.resource.data.challengeId)
                      && request.resource.data.staffUid == uid()
                      && validChallengeScore(request.resource.data.challengeId,
                                             request.resource.data.rawValue);
        // 攤位只能作廢自己 10 分鐘內送出的紀錄
        allow update: if isAdmin()
                      || ( isBooth()
                           && resource.data.staffUid == uid()
                           && onlyChanged(['voided', 'voidReason'])
                           && request.time < resource.data.createdAt + duration.value(10, 'm') );
        allow delete: if false;
      }

      match /leaderboards/{lbId} {
        allow read:  if true;
        allow write: if false;
      }

      // ── 報名：公開表單，只能建 pending ──
      match /registrations/{regId} {
        allow read:   if isAdmin();
        allow create: if request.resource.data.status == 'pending';
        allow update: if isAdmin();
        allow delete: if false;
      }

      // ── 稽核：只能新增，不可改不可刪 ──
      match /audits/{auditId} {
        allow read:   if isAdmin();
        allow create: if isStaff() && request.resource.data.actor.uid == uid();
        allow update, delete: if false;
      }

      // ── 申訴（規章第二十條）──
      // 申訴書是紙本親簽，這裡是主辦的登記與裁決紀錄：有事由、電話、保證金去向，
      // 只有管理員讀寫。不可刪除——申訴紀錄跟稽核一樣要留著（R-SEC-002 的同一個精神）。
      match /appeals/{appealId} {
        allow read:   if isAdmin();
        allow create, update: if isAdmin();
        allow delete: if false;
      }

      // ── 抽獎中獎聯絡方式（docs/06 §7.2）──
      // players 文件任何人都讀得到，電話不能放在那裡。這一份只有管理員（匯出抽獎名單時）
      // 讀得到；寫入一律走 Function（setPlayerContact 用只有本人知道的憑證驗過才寫）。
      match /playerContacts/{playerId} {
        allow read:  if isAdmin();
        allow write: if false;
      }

      match /awards/{awardId} {
        allow read:  if resource.data.published == true || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ══════════════════ 根層級 ══════════════════
    // ── 球員出賽紀錄：collectionGroup('timeline') ──────────────
    // timeline 在 matches/{id}/timeline 底下已經是 allow read: if true，
    // 但**巢狀路徑的規則吃不到 collectionGroup 查詢**，要另外開這一條，
    // 否則球員頁的「出賽紀錄」永遠是 PERMISSION_DENIED。
    //
    // 只開 read，而且開的是同一批已經公開的資料——事件上的 playerName
    // 來自賽務端從公開名冊（roster）挑的 displayName，未滿 13 歲已遮蔽。
    // 寫入一律走上面那條（賽務／Admin，且永不刪除，R-SEC-002）。
    match /{path=**}/timeline/{timelineId} {
      allow read: if true;
    }

    // ── 我的球員：collectionGroup('members') ──────────────────
    // 家長／本人在 #/my 看「我報名的球員」要**跨球隊**查（docs/10 §1.3：
    // 一個 LINE 帳號可以對應多個球員，分在不同隊）。跟上面的 timeline 一樣，
    // 巢狀路徑的規則吃不到 collectionGroup 查詢，要另外開這一條。
    //
    // 只開 read，而且只開「guardianUid 是自己」——這份文件上有生日與身分證後四碼。
    // 查詢**一定要帶** where('guardianUid', '==', 自己的 uid)：rules 對查詢是看
    // 條件能不能證明每一筆都通過，沒帶的話整個查詢被擋（R134c）。
    // 刻意不用 .get('guardianUid', '') 給預設值：教練填的小球員沒有 guardianUid，
    // 本來就不該從這條路讀到；欄位缺漏時求值失敗＝拒絕，正是要的方向。
    match /{path=**}/members/{memberId} {
      allow read: if isAuth() && resource.data.guardianUid == uid();
    }

    // 報名開關收到**總管**，其餘設定維持管理員。
    //
    // `PERMISSIONS` 裡 `registration.manage` 的 minRole 是 super_admin，
    // 而它是 destructive——destructive 的權限一定要同時寫在規則裡
    // （R-PERM-002）。留在 isAdmin() 的話，畫面上看不到那顆開關的管理員
    // 仍然改得動報名截止日。
    //
    // ⚠️ **不可以另外寫一條 `match /config/registration`。**
    //    Firestore 的規則在多條路徑同時命中時是 **OR**，不是「以最具體的為準」——
    //    再寫一條收緊的規則，下面這條萬用字元照樣會放行管理員，
    //    而且看起來完全像收緊了。所以條件要寫在**同一條**裡。
    match /config/{key} {
      allow read:  if true;
      allow write: if key == 'registration' ? isSuperAdmin() : isAdmin();
    }
    match /rolePermissions/{role} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }
    match /userPermissionGrants/{u} {
      allow read:  if isAuth() && (u == uid() || isAdmin());
      allow write: if isAdmin();
    }
    // ── 使用者名錄（docs/10 §1.4）─────────────────────────────
    // LINE 的 userId 沒辦法憑空查，所以任何人登入時都留一筆自己的紀錄，
    // 大總管才有名單可以指派身分。
    match /users/{u} {
      allow read: if isAuth() && (u == uid() || isAdmin());

      // 自己只寫得動自己那一筆，而且**不准帶 roles**：
      // 那是給後台列表用的快取，權威永遠是 staff/{uid}.roles。
      // 少了這道，任何人登入時就能自稱 admin，後台列表會照著顯示。
      allow create: if isAdmin()
                    || ( isAuth() && u == uid()
                         && request.resource.data.uid == u
                         && !('roles' in request.resource.data) );
      allow update: if isAdmin()
                    || ( isAuth() && u == uid()
                         && request.resource.data.uid == u
                         && request.resource.data.get('roles', [])
                              == resource.data.get('roles', []) );
      allow delete: if false;
    }

    match /staff/{u} {
      allow read:  if isAuth() && (u == uid() || isAdmin());

      // ⚠️ 權限升級只有一條路：**只有 super_admin 動得了身分**（docs/10 §5.1）。
      //    Admin 連自己的都改不了，也造不出第二個大總管——
      //    staffRolesAssignable() 的白名單裡沒有 super_admin。
      //
      //    這裡原本是 `allow write: if isAdmin()`，等於任何管理員都能把自己
      //    升成大總管。這條線必須由 rules 強制，不看 rolePermissions
      //    （R-RULES-002：動態權限只用在 UI 層）——FC 的 R-IAM-004 就是
      //    動態權限與 rules 不同步造成的已知漏洞，不要複製那個模式。
      allow create: if isSuperAdmin() && staffRolesAssignable(request.resource.data);
      // 更新時允許「角色原封不動」，大總管才改得了自己的指派場地
      // （他自己的 roles 是 ['super_admin']，過不了白名單）。
      allow update: if isSuperAdmin()
                    && ( staffRolesAssignable(request.resource.data)
                         || request.resource.data.roles == resource.data.roles );
      allow delete: if isSuperAdmin();

      // ── Demo 專用：自助建立工作人員身分 ──────────────────────
      // 目的：demo 站要能免 LINE 登入就試用賽務台（也供 M6 彩排用）。
      //
      // 這是一次「權限放寬」，因此三道鎖缺一不可：
      //   1. 只有 config/env.allowSelfServeStaff == true 的專案才生效。
      //      正式專案沒有這份文件（seed 有安全鎖，只灌 demo），所以 exists() 為 false。
      //      而 config 只有 Admin 寫得動，等於「除非管理員主動開啟，否則永遠關著」。
      //   2. 只能建立**自己**的那一份（u == uid()）。
      //   3. 角色白名單**不含 admin / super_admin**——
      //      自助身分永遠拿不到改判、退回完賽、改設定這些權限。
      allow create: if isAuth() && u == uid()
                    && selfServeAllowed()
                    && validSelfServe(request.resource.data);
      allow update: if isAuth() && u == uid()
                    && selfServeAllowed()
                    && resource.data.get('selfServe', false) == true
                    && validSelfServe(request.resource.data);
    }

    // 預設拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
