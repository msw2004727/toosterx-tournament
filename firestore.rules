rules_version = '2';

// ══════════════════════════════════════════════════════════════════
//  toosterx-tournament｜Firestore 安全規則
//  規格：docs/07-權限安全與CloudFunctions.md
//
//  設計前提：比分「寫入」放在客戶端（為了拿到 SDK 的離線佇列），
//            所以 rules 就是唯一防線，必須寫得很緊。
//
//  ⚠️ 修改後務必跑 `npm run test:rules`（R01–R23 全綠才可部署）
// ══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{db}/documents {

    // ── 基礎 ─────────────────────────────────────────────────
    function isAuth()    { return request.auth != null; }
    function uid()       { return request.auth.uid; }
    function staffPath() { return /databases/$(db)/documents/staff/$(uid()); }

    // ⚠️ 效能鐵則：Firestore rules 每個請求最多評估 1000 個運算式。
    //    角色判斷一律經過 myRoles()，**不要**再寫 isA() 呼叫 isB() 的巢狀鏈
    //    （例如 isScorer → isLead → isAdmin → hasRole → isStaff），
    //    那會把 staff 文件重複展開數十次，很容易撞到上限，
    //    讓「合法」的寫入也被判 PERMISSION_DENIED。
    function myRoles() {
      return isAuth() && exists(staffPath()) && get(staffPath()).data.active == true
        ? get(staffPath()).data.roles
        : [];
    }
    function isStaff()      { return myRoles().size() > 0; }
    function isSuperAdmin() { return myRoles().hasAny(['super_admin']); }
    function isAdmin()      { return myRoles().hasAny(['admin', 'super_admin']); }
    function isLead()       { return myRoles().hasAny(['admin', 'super_admin', 'venue_lead']); }
    function isScorer()     { return myRoles().hasAny(['admin', 'super_admin', 'venue_lead',
                                                        'scorer', 'referee']); }
    function isBooth()      { return myRoles().hasAny(['admin', 'super_admin', 'venue_lead', 'booth']); }

    // ── 指派範圍 ─────────────────────────────────────────────
    // 只有非 admin 才會走到 myAssignment()，此時 staff 文件必定存在
    function myAssignment() { return get(staffPath()).data.assignment; }
    function assignedVenue(venueId) {
      return myRoles().hasAny(['admin', 'super_admin'])
        || myAssignment().venueIds.size() == 0
        || venueId in myAssignment().venueIds;
    }
    function assignedChallenge(cid) {
      return myRoles().hasAny(['admin', 'super_admin'])
        || cid in myAssignment().challengeIds;
    }

    // ── Demo 自助身分（見下方 match /staff/{u} 的說明）─────────
    // 只在 config/env.allowSelfServeStaff == true 的專案生效。
    // 這個 get() 只出現在 staff 文件的 create/update 路徑，
    // 不在比分寫入的熱路徑上，所以不會影響 1000 運算式上限（R-RULES-001）。
    function selfServeAllowed() {
      return exists(/databases/$(db)/documents/config/env)
        && get(/databases/$(db)/documents/config/env).data.get('allowSelfServeStaff', false) == true;
    }
    function validSelfServe(d) {
      return d.get('selfServe', false) == true
        && d.get('uid', '') == uid()
        && d.get('active', false) == true
        && d.roles is list
        && d.roles.size() > 0
        && d.roles.hasOnly(['scorer', 'referee', 'venue_lead', 'booth']);
    }

    // ── 欄位控制 ─────────────────────────────────────────────
    function onlyChanged(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    function unchanged(f) {
      return request.resource.data[f] == resource.data[f];
    }
    function validScore(v) {
      return v is int && v >= 0 && v <= 99;
    }

    // 非 Admin 分支專用的狀態機。
    // postponed / cancelled / walkover 一律不在清單中，
    // 因此只有 Admin 分支（不經此函式）才設得了這三種狀態。
    function validStatusTransition(from, to) {
      return (from == 'scheduled' && to in ['checkin', 'ready', 'live'])
          || (from == 'checkin'   && to in ['ready', 'scheduled'])
          || (from == 'ready'     && to in ['live', 'checkin'])
          || (from == 'live'      && to in ['halftime', 'finished'])
          || (from == 'halftime'  && to in ['live', 'finished'])
          || from == to;
    }

    // ══════════════════════════════════════════════════════════
    match /events/{eventId} {
      allow read:  if true;
      allow write: if isAdmin();

      function validChallengeScore(cid, v) {
        let c = get(/databases/$(db)/documents/events/$(eventId)/challenges/$(cid)).data;
        return v is number && v >= c.minValue && v <= c.maxValue;
      }

      // ── 組別／階段／小組 ──
      match /divisions/{divisionId} {
        allow read:  if true;
        allow write: if isAdmin();
        match /{sub=**} {
          allow read:  if true;
          allow write: if isAdmin();
        }
      }

      // ── 球隊 ──
      match /teams/{teamId} {
        allow read:                 if true;
        allow create, update, delete: if isAdmin();

        // 聯絡資訊等敏感欄位放子集合，避免公開讀取
        match /private/{docId} {
          allow read, write: if isScorer();
        }

        // 完整名單（生日、身分證後四碼）：僅賽務以上
        match /members/{memberId} {
          allow read:  if isScorer();
          allow write: if isAdmin();
        }

        // 公開投影：任何人可讀，只有 Admin SDK（Function）可寫
        match /roster/{memberId} {
          allow read:  if true;
          allow write: if false;
        }
      }

      // ── 場次 ──
      match /matches/{matchId} {
        allow read: if true;
        allow create, delete: if isAdmin();

        allow update: if
          // (A) Admin 全權
          isAdmin()

          // (B) 賽務：限指派場地、限未鎖定、限白名單欄位
          || ( isScorer()
               && assignedVenue(resource.data.venueId)
               && resource.data.lock.locked == false
               && onlyChanged([
                    'score', 'htScore', 'penaltyScore', 'status', 'period', 'clock',
                    'result', 'checkin', 'lock', 'scoreSubmittedAt', 'scoreSubmittedBy',
                    'scoreMismatch', 'updatedAt', 'updatedBy'
                  ])
               && request.resource.data.updatedBy == uid()
               && validStatusTransition(resource.data.status, request.resource.data.status)
               && validScore(request.resource.data.score.home)
               && validScore(request.resource.data.score.away)
               && unchanged('home') && unchanged('away')
               && unchanged('divisionId') && unchanged('stageId') )

          // (C) 場地主任覆核：已鎖定的 finished 也能改成 confirmed，但只准動 status
          || ( isLead()
               && assignedVenue(resource.data.venueId)
               && resource.data.status == 'finished'
               && request.resource.data.status == 'confirmed'
               && onlyChanged(['status', 'updatedAt', 'updatedBy'])
               && request.resource.data.updatedBy == uid() );

        // ── 比賽事件：永不刪除，只作廢 ──
        match /timeline/{timelineId} {
          allow read:   if true;
          allow create: if (isScorer() || isAdmin())
                        && request.resource.data.createdBy == uid()
                        && request.resource.data.matchId == matchId;
          allow update: if isAdmin()
                        || (isScorer()
                            && onlyChanged(['voided', 'voidedBy', 'voidedAt', 'voidReason']));
          allow delete: if false;
        }
      }

      // ── 積分榜：Function 走 Admin SDK 繞過 rules ──
      match /standings/{standingId} {
        allow read:  if true;
        allow write: if isAdmin();
      }

      match /matchSheets/{sheetId} {
        allow read:  if true;
        allow write: if isScorer() || isAdmin();
      }

      // ── 檢錄：doc id = matchId__memberId，天然防重複 ──
      match /checkins/{checkinId} {
        allow read:   if isScorer() || isAdmin();
        allow create: if isScorer()
                      && request.resource.data.scannedBy == uid()
                      && checkinId == request.resource.data.matchId + '__'
                                      + request.resource.data.memberId;
        allow update: if isAdmin();
        allow delete: if false;
      }

      match /venues/{venueId} {
        allow read:  if true;
        allow write: if isAdmin();
      }

      // ── 彙總看板：Function 產出 ──
      match /boards/{boardId} {
        allow read:  if true;
        allow write: if false;
      }

      // ── Challenge ──
      match /challenges/{challengeId} {
        allow read:  if true;
        allow write: if isAdmin();
      }

      match /players/{playerId} {
        allow read: if true;
        // 任何人可建立自己的 Game Pass，但欄位與初始值受限
        allow create: if request.resource.data.keys().hasOnly([
                          'playerId', 'eventId', 'nickname', 'avatarSeed', 'ageBand',
                          'qrCode', 'createdAt', 'createdVia', 'completedChallengeIds',
                          'luckyDrawEntries', 'linkedTeamId', 'lastActiveAt', 'contact'
                        ])
                      && request.resource.data.nickname is string
                      && request.resource.data.nickname.size() >= 1
                      && request.resource.data.nickname.size() <= 12
                      && request.resource.data.completedChallengeIds.size() == 0
                      && request.resource.data.luckyDrawEntries == 0;
        // 進度與抽獎張數只有 Function／Admin 可改
        allow update: if isAdmin()
                      || onlyChanged(['nickname', 'lastActiveAt', 'contact']);
        allow delete: if isAdmin();
      }

      match /attempts/{attemptId} {
        allow read:   if true;
        allow create: if isBooth()
                      && assignedChallenge(request.resource.data.challengeId)
                      && request.resource.data.staffUid == uid()
                      && validChallengeScore(request.resource.data.challengeId,
                                             request.resource.data.rawValue);
        // 攤位只能作廢自己 10 分鐘內送出的紀錄
        allow update: if isAdmin()
                      || ( isBooth()
                           && resource.data.staffUid == uid()
                           && onlyChanged(['voided', 'voidReason'])
                           && request.time < resource.data.createdAt + duration.value(10, 'm') );
        allow delete: if false;
      }

      match /leaderboards/{lbId} {
        allow read:  if true;
        allow write: if false;
      }

      // ── 報名：公開表單，只能建 pending ──
      match /registrations/{regId} {
        allow read:   if isAdmin();
        allow create: if request.resource.data.status == 'pending';
        allow update: if isAdmin();
        allow delete: if false;
      }

      // ── 稽核：只能新增，不可改不可刪 ──
      match /audits/{auditId} {
        allow read:   if isLead();
        allow create: if isStaff() && request.resource.data.actor.uid == uid();
        allow update, delete: if false;
      }

      match /awards/{awardId} {
        allow read:  if resource.data.published == true || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ══════════════════ 根層級 ══════════════════
    match /config/{key} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /rolePermissions/{role} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }
    match /userPermissionGrants/{u} {
      allow read:  if isAuth() && (u == uid() || isAdmin());
      allow write: if isAdmin();
    }
    match /staff/{u} {
      allow read:  if isAuth() && (u == uid() || isLead());
      allow write: if isAdmin();

      // ── Demo 專用：自助建立工作人員身分 ──────────────────────
      // 目的：demo 站要能免 LINE 登入就試用賽務台（也供 M6 彩排用）。
      //
      // 這是一次「權限放寬」，因此三道鎖缺一不可：
      //   1. 只有 config/env.allowSelfServeStaff == true 的專案才生效。
      //      正式專案沒有這份文件（seed 有安全鎖，只灌 demo），所以 exists() 為 false。
      //      而 config 只有 Admin 寫得動，等於「除非管理員主動開啟，否則永遠關著」。
      //   2. 只能建立**自己**的那一份（u == uid()）。
      //   3. 角色白名單**不含 admin / super_admin**——
      //      自助身分永遠拿不到改判、退回完賽、改設定這些權限。
      allow create: if isAuth() && u == uid()
                    && selfServeAllowed()
                    && validSelfServe(request.resource.data);
      allow update: if isAuth() && u == uid()
                    && selfServeAllowed()
                    && resource.data.get('selfServe', false) == true
                    && validSelfServe(request.resource.data);
    }

    // 預設拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
